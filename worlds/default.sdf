      <!-- ── Chassis ── -->
      <link name="chassis">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1326</mass>
          <inertia>
            <ixx>534.7</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2099.4</iyy><iyz>0</iyz>
            <izz>2139.2</izz>
